# Copy to .env; never commit real credentials.
NETCORE_WEB_PORT=3000
NETCORE_DB_PASSWORD=replace-with-a-long-random-password

# Only required by compose.deploy.yaml:
NETCORE_DB_ADMIN_PASSWORD=replace-with-a-different-long-random-password
NETCORE_DOMAIN=netcore.example.com
# Use single quotes around the bcrypt hash to preserve dollar signs in Compose.
# Generate it interactively: docker run --rm -it caddy:2-alpine caddy hash-password
NETCORE_DEMO_PASSWORD_HASH=''
